# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (e.g. mongodb://localhost:27017/vibhanu_crm or mongodb+srv://...)
MONGO_URI=mongodb://127.0.0.1:27017/vibhanu_crm

# JWT Secret & Token Expiry
JWT_SECRET=vibhanu_crm_super_secure_jwt_secret_key_2026_dev_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Client URLs (comma separated for multiple origins)
CLIENT_URL=http://localhost:3000

# File Upload Directory
UPLOAD_DIR=./uploads

# Max Audio File Upload Size in bytes (default: 15MB = 15728640)
MAX_AUDIO_FILE_SIZE=15728640

# Cloudinary Audio Storage (Required for persistent audio storage and streaming)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
